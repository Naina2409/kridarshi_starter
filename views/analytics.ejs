<%- include("partials/header") %>

<div class="row g-4">
  <div class="col-12">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
          <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <span>📈</span> <%= T.profit_title || 'Crop Profitability & Resource Utilization Analysis' %>
          </h5>
          <small class="text-muted">Comparative economics, input intensity, water footprint, and return on investment</small>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">Benchmark Standard: 1 Acre Basis</span>
      </div>

      <div class="card-body p-4">
        <!-- High Level Summary Cards -->
        <div class="row g-3 mb-4">
          <div class="col-md-3 col-sm-6">
            <div class="p-3 bg-light rounded-3 border">
              <div class="small text-muted fw-semibold">Highest ROI Crop</div>
              <div class="stat-number text-success my-1">249.5%</div>
              <div class="small text-muted">Yellow Mustard (Low Water Footprint)</div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="p-3 bg-light rounded-3 border">
              <div class="small text-muted fw-semibold">Maximum Net Profit / Acre</div>
              <div class="stat-number text-primary my-1">₹1,61,300</div>
              <div class="small text-muted">Nashik Red Onion (High Value Cash Crop)</div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="p-3 bg-light rounded-3 border">
              <div class="small text-muted fw-semibold">Most Water Efficient</div>
              <div class="stat-number text-info my-1">6.19 <span class="fs-6">kg/1000L</span></div>
              <div class="small text-muted">Potato (Tuber Bulking Index)</div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="p-3 bg-light rounded-3 border">
              <div class="small text-muted fw-semibold">Lowest Risk Stability</div>
              <div class="stat-number text-secondary my-1">Wheat</div>
              <div class="small text-muted">Guaranteed MSP Safety & Assured Market</div>
            </div>
          </div>
        </div>

        <!-- Comprehensive Profitability Matrix Table -->
        <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <span>📊</span> Multi-Crop Economics & Cultivation Cost Breakdown
        </h6>
        <div class="table-responsive mb-4">
          <table class="table table-hover align-middle border mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Crop & Variety</th>
                <th>Season</th>
                <th>Avg Yield / Acre</th>
                <th>Mkt Price</th>
                <th>Gross Revenue</th>
                <th>Cultivation Cost</th>
                <th>Net Profit</th>
                <th>ROI (%)</th>
                <th>Risk Profile</th>
              </tr>
            </thead>
            <tbody>
              <% for (const c of crops) { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark"><%= c.crop %></td>
                  <td><span class="badge bg-light text-dark border"><%= c.season %></span></td>
                  <td><strong><%= c.avgYieldQuintalsPerAcre %></strong> q</td>
                  <td>₹<%= c.marketPricePerQuintal.toLocaleString('en-IN') %>/q</td>
                  <td>₹<%= c.grossRevenuePerAcre.toLocaleString('en-IN') %></td>
                  <td>
                    <span title="Seeds: ₹<%= c.cultivationCostPerAcre.seeds %>, Fert: ₹<%= c.cultivationCostPerAcre.fertilizer %>, Labor: ₹<%= c.cultivationCostPerAcre.labor %>">
                      ₹<%= c.cultivationCostPerAcre.total.toLocaleString('en-IN') %>
                    </span>
                  </td>
                  <td>
                    <strong class="text-success fs-6">₹<%= c.netProfitPerAcre.toLocaleString('en-IN') %></strong>
                  </td>
                  <td>
                    <span class="badge bg-success-subtle text-success fs-6 px-2 py-1">
                      <%= c.roiPercentage %>%
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= c.riskRating === 'Low' ? 'bg-success-subtle text-success' : c.riskRating === 'Medium' ? 'bg-warning-subtle text-warning-emphasis' : 'bg-danger-subtle text-danger' %>">
                      <%= c.riskRating %> Risk
                    </span>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Resource Utilization & Water / Fertilizer Intensity -->
        <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <span>💧</span> Resource Utilization & Sustainability Metrics
        </h6>
        <div class="row g-3">
          <% for (const c of crops) { %>
            <div class="col-md-4 col-sm-6">
              <div class="p-3 bg-light rounded-3 border h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-bold text-dark"><%= c.crop.split(' ')[0] %></span>
                  <span class="badge bg-secondary-subtle text-secondary small"><%= c.season %></span>
                </div>
                <div class="mb-2">
                  <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Water Footprint:</span>
                    <strong><%= (c.waterConsumptionLitersPerAcre / 1000000).toFixed(2) %>M Liters/Acre</strong>
                  </div>
                  <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: <%= Math.min(100, (c.waterConsumptionLitersPerAcre / 4500000) * 100) %>%;"></div>
                  </div>
                </div>
                <div class="mb-2">
                  <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Fertilizer Intensity:</span>
                    <strong><%= c.fertilizerInputKgPerAcre %> kg/Acre</strong>
                  </div>
                  <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: <%= Math.min(100, (c.fertilizerInputKgPerAcre / 200) * 100) %>%;"></div>
                  </div>
                </div>
                <div class="small text-muted mt-2 border-top pt-2">
                  🔄 <strong>Rotation:</strong> <%= c.recommendedRotation %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
