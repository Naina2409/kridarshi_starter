<%- include('../partials/header') %>

<div class="row justify-content-center py-3">
  <div class="col-md-8 col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <span>🔐</span> <%= T.auth_signin_title || 'Farmer & Trader Sign In' %>
        </h5>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><%= T.auth_secure_badge || 'Secure Auth' %></span>
      </div>
      <div class="card-body p-4">
        <% if (locals.error && error) { %>
          <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3">
            <span>⚠️</span> <span><%= error %></span>
          </div>
        <% } %>
        <% if (locals.success && success) { %>
          <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3">
            <span>✅</span> <span><%= success %></span>
          </div>
        <% } %>

        <form action="/auth/login/" method="POST" id="login-form">
          <input type="hidden" name="next" value="<%= nextUrl || '/' %>">
          
          <div class="mb-3">
            <label for="login-phone" class="form-label small fw-semibold text-muted"><%= T.auth_login_phone || 'Mobile Number / Phone' %></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted small">+91</span>
              <input type="tel" name="phone" id="login-phone" class="form-control" placeholder="9800000000" value="<%= locals.phone || '' %>" required autocomplete="tel">
            </div>
            <div class="form-text small"><%= T.auth_login_phone_help || 'Use registered 10-digit mobile number.' %></div>
          </div>

          <div class="mb-3">
            <label for="login-password" class="form-label small fw-semibold text-muted"><%= T.auth_password || 'Password / PIN' %></label>
            <input type="password" name="password" id="login-password" class="form-control" placeholder="<%= T.auth_login_password_placeholder || 'Enter password' %>" required autocomplete="current-password">
          </div>

          <button type="submit" class="btn btn-success w-100 py-2 fw-semibold shadow-sm mb-3">
            <%= T.auth_btn_login || 'Sign In to Farm Dashboard' %>
          </button>
        </form>

        <!-- Quick Demo Switcher -->
        <div class="p-3 bg-light rounded-3 border mb-3">
          <div class="small fw-bold text-muted mb-2"><%= T.auth_demo_title || '⚡ Quick 1-Click Demo Login:' %></div>
          <div class="d-flex flex-column gap-2">
            <form action="/auth/demo/" method="POST" class="d-inline">
              <input type="hidden" name="role" value="farmer">
              <button type="submit" class="btn btn-outline-success btn-sm w-100 text-start d-flex justify-content-between align-items-center">
                <span>👨‍🌾 <strong>Ramesh Kumar</strong> (Farmer, Sonipat)</span>
                <span class="badge bg-success text-white"><%= T.auth_demo_farmer_badge || 'Farmer Role' %></span>
              </button>
            </form>
            <form action="/auth/demo/" method="POST" class="d-inline">
              <input type="hidden" name="role" value="trader">
              <button type="submit" class="btn btn-outline-primary btn-sm w-100 text-start d-flex justify-content-between align-items-center">
                <span>🏪 <strong>Sunil Gupta</strong> (Trader, Azadpur Mandi)</span>
                <span class="badge bg-primary text-white"><%= T.auth_demo_trader_badge || 'Trader Role' %></span>
              </button>
            </form>
          </div>
        </div>

        <div class="text-center pt-2 border-top">
          <span class="small text-muted"><%= T.auth_new_to_app || 'New to KriDarshi?' %></span>
          <a href="/auth/register/" class="small text-success fw-semibold ms-1"><%= T.auth_create_account_link || 'Create Farmer / Trader Account →' %></a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
