<%- include("partials/header") %>

<div class="row g-4">
  <!-- Mandi Price Comparison Header -->
  <div class="col-12">
    <div class="card shadow-sm border-0 mb-2">
      <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
          <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <span>🏪</span> Agricultural Marketplace & Mandi Price Board
          </h5>
          <small class="text-muted">Live Agmarknet mandi spot rates & direct trader connection network</small>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">Direct Buyer Connection Active</span>
        </div>
      </div>
      <div class="card-body p-4">
        <div class="row g-3">
          <% for (const p of marketPrices) { %>
            <div class="col-md-3 col-sm-6">
              <div class="p-3 bg-light rounded-3 border">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <span class="fw-bold text-dark"><%= p.crop %></span>
                  <span class="badge <%= p.trend === 'up' ? 'bg-success-subtle text-success' : p.trend === 'down' ? 'bg-danger-subtle text-danger' : 'bg-secondary-subtle text-secondary' %>">
                    <%= p.trend === 'up' ? '▲ Rising' : p.trend === 'down' ? '▼ Falling' : '■ Steady' %>
                  </span>
                </div>
                <div class="fs-4 fw-bold text-success my-1">₹<%= (p.price_per_quintal || 0).toLocaleString('en-IN') %><span class="fs-6 text-muted fw-normal">/q</span></div>
                <div class="small text-muted">Primary Mandi: <%= p.market || 'Sonipat / Azadpur' %></div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Verified Trader Directory -->
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <span>🤝</span> <%= T.traders_title || 'Verified Mandi Traders & Bulk Aggregators' %>
        </h6>
        <span class="small text-muted">Zero commission direct transaction</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Trader & Firm</th>
                <th>Mandi / Location</th>
                <th>Buying Commodity</th>
                <th>Quoted Price</th>
                <th>Trust Score</th>
                <th class="pe-3 text-end">Direct Contact</th>
              </tr>
            </thead>
            <tbody>
              <% for (const t of traders) { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold text-dark"><%= t.name %></div>
                    <small class="text-muted"><%= t.firmName %></small>
                  </td>
                  <td>
                    <div><%= t.mandi %></div>
                    <small class="text-muted"><%= t.state %></small>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= t.crop %></span>
                  </td>
                  <td>
                    <strong class="text-success">₹<%= t.quotedPrice.toLocaleString('en-IN') %></strong><span class="small text-muted">/q</span>
                  </td>
                  <td>
                    <span class="text-warning">★</span> <strong><%= t.rating %></strong>
                    <span class="badge bg-success-subtle text-success py-0 px-1" style="font-size: 0.7rem;">Verified</span>
                  </td>
                  <td class="pe-3 text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="tel:<%= t.phone %>" class="btn btn-outline-success">
                        📞 Call
                      </a>
                      <a href="https://wa.me/<%= t.phone.replace('+', '') %>?text=Hello%20<%= encodeURIComponent(t.name) %>,%20I%20am%20interested%20in%20selling%20my%20produce%20via%20KriDarshi" target="_blank" class="btn btn-success text-white">
                        💬 WhatsApp
                      </a>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Post Produce Listing Form -->
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <span>📢</span> Post Produce for Sale
        </h6>
      </div>
      <div class="card-body p-4">
        <form action="/marketplace/post/" method="POST" id="post-sale-form">
          <div class="mb-3">
            <label for="post-crop" class="form-label small fw-semibold text-muted">Select Commodity</label>
            <select name="crop" id="post-crop" class="form-select form-select-sm">
              <option value="Wheat">Wheat (Kanak)</option>
              <option value="Basmati Rice">Basmati Rice</option>
              <option value="Yellow Mustard">Yellow Mustard</option>
              <option value="Nashik Red Onion">Nashik Red Onion</option>
              <option value="Potato">Potato</option>
              <option value="Banana">Fresh Banana Crate</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="post-quantity" class="form-label small fw-semibold text-muted">Available Quantity (Quintals)</label>
            <input type="number" step="1" min="1" name="quantity" id="post-quantity" class="form-control form-control-sm" value="20" required>
          </div>
          <div class="mb-3">
            <label for="post-asking-price" class="form-label small fw-semibold text-muted">Expected Price (₹/Quintal)</label>
            <input type="number" step="50" min="500" name="price" id="post-asking-price" class="form-control form-control-sm" value="2300" required>
          </div>
          <div class="mb-3">
            <label for="post-mandi-pickup" class="form-label small fw-semibold text-muted">Pickup Location / Village</label>
            <input type="text" name="location" id="post-mandi-pickup" class="form-control form-control-sm" value="<%= farmer.village %>" required>
          </div>
          <button type="submit" class="btn btn-success w-100 btn-sm fw-semibold">
            Broadcast to All Verified Traders
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
